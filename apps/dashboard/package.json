{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint ."
  },
  "dependencies": {
    "@noisif/assets": "workspace:*",
    "@noisif/lib": "workspace:*",
    "@noisif/tailwind-config": "workspace:*",
    "@noisif/types": "workspace:*",
    "@noisif/ui": "workspace:*",
    "@sentry/sveltekit": "^11.17.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
