{
  "name": "noisif-web-monorepo",
  "version": "0.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dashboard:dev": "pnpm --filter dashboard run dev",
    "dashboard:build": "pnpm --filter dashboard run build",
    "dashboard:preview": "pnpm --filter dashboard run preview",
    "landing-page:dev": "pnpm --filter landing-page run dev",
    "landing-page:build": "pnpm --filter landing-page run build",
    "landing-page:preview": "pnpm --filter landing-page run preview",
    "copyright": "noisif-copyright",
    "prepare": "husky",
    "format": "pnpm run copyright && prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run format:check && pnpm -r run lint"
  },
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@noisif/copyright": "workspace:*",
    "@noisif/eslint-config": "workspace:*",
    "@noisif/prettier-config": "workspace:*",
    "@noisif/tsconfig": "workspace:*",
    "@types/node": "^24",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "prettier --write"
    ]
  }
}
